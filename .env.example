# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Client Configuration (Safe for browser / client-side)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Supabase Server-Side Secret Key (Optional server-side direct administration / service role)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Server-Side Research Provider Key (Optional if using an external search API like Tavily/SerpAPI, fallback to Google GenAI Grounded Search)
RESEARCH_API_KEY=""

# YouTube Data API v3 Key (Optional for dynamic YouTube resource discovery. If omitted, engine uses verified curated educational catalog without crashing)
YOUTUBE_API_KEY=""
